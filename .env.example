# Copied to .env by `uv run poe setup` (also part of `poe dev` and `poe up`). Never commit .env.
# Every FLASK_<KEY> variable sets config key <KEY>; defaults live in app/config.py.
# Generate a real key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me

# Default database: SQLite in ./instance/app.db. To use the Postgres from compose (`docker compose up -d db`):
# FLASK_SQLALCHEMY_DATABASE_URI=postgresql+psycopg://app:app@localhost:5432/app

# Mail goes to Mailpit on localhost:1025 by default (`uv run poe mail`, inbox at http://localhost:8025).
# FLASK_MAIL_SERVER=smtp.example.com
# FLASK_MAIL_PORT=587
# FLASK_MAIL_USE_TLS=true
# FLASK_MAIL_USERNAME=...
# FLASK_MAIL_PASSWORD=...

# Production behind a TLS proxy:
# FLASK_FORCE_HTTPS=true
# FLASK_PROXY_COUNT=1
# FLASK_CORS_ORIGINS=["https://app.example.com"]
